{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "pina": {
      "type": "streamable-http",
      "url": "https://www.pinastudio.jp/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "PENDING_PUBLIC_CLIENT_REGISTRATION",
              "tokenEndpointAuthMethod": "none"
            },
            "baseScopes": [
              "credits:read",
              "generation:read",
              "generation:write"
            ]
          }
        }
      }
    }
  }
}
