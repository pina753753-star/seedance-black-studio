{
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "routes": [
    {
      "src": "^/api/(?:seedance-start(?:-priced)?|_lib/seedance-start|h3-live/start|h3-director/start-session|h3-director/approve-prompt|video-edit|storyboard-prompt|stripe-checkout)(?:\\.js)?/?$",
      "dest": "/api/maintenance"
    },
    {
      "src": "^/(?:|(?:index|generate(?:-prod|-cool)?|pricing|h3-live|h3-max-beta|h3-director|seedance-reference-test(?:-v5)?|admin-seedance|admin-veo|maintenance)(?:\\.html)?/?)$",
      "dest": "/maintenance.html",
      "status": 503,
      "headers": {
        "Cache-Control": "no-store"
      }
    },
    {
      "src": "/api/seedance-start",
      "dest": "/api/seedance-start-priced"
    },
    {
      "src": "/api/storyboard",
      "dest": "/api/seedance-status?_r=sb"
    },
    {
      "src": "/h3-live.html",
      "dest": "/h3-max-beta.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/",
      "dest": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron-annual-credit-grant",
      "schedule": "15 0 * * *"
    },
    {
      "path": "/api/openrouter-reconcile",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/wavespeed-reconcile",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/video-edit-reconcile",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/reference-audio-cleanup",
      "schedule": "37 * * * *"
    },
    {
      "path": "/api/h3-live/image-cleanup",
      "schedule": "47 * * * *"
    }
  ]
}
