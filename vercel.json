{
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/reference-dance-confirm-upload.js": {
      "maxDuration": 300
    },
    "api/mcp.js": {
      "maxDuration": 300,
      "includeFiles": "local-mcp/**"
    }
  },
  "routes": [
    {
      "src": "/.well-known/(oauth-authorization-server|openid-configuration)/mcp/oauth",
      "dest": "/api/mcp"
    },
    {
      "src": "/mcp/(.*)",
      "dest": "/api/mcp"
    },
    {
      "src": "/interaction/(.*)",
      "dest": "/api/mcp"
    },
    {
      "src": "/.well-known/oauth-protected-resource(?:/api/mcp)?",
      "dest": "/api/mcp"
    },
    {
      "src": "/api/seedance-start",
      "dest": "/api/seedance-start-priced"
    },
    {
      "src": "/api/storyboard",
      "dest": "/api/seedance-status?_r=sb"
    },
    {
      "src": "/h3-live.html",
      "dest": "/h3-max-beta.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/",
      "dest": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron-annual-credit-grant",
      "schedule": "15 0 * * *"
    },
    {
      "path": "/api/openrouter-reconcile",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/wavespeed-reconcile",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/video-edit-reconcile",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/reference-audio-cleanup",
      "schedule": "37 * * * *"
    },
    {
      "path": "/api/reference-dance-cleanup",
      "schedule": "42 * * * *"
    },
    {
      "path": "/api/h3-live/image-cleanup",
      "schedule": "47 * * * *"
    }
  ]
}
